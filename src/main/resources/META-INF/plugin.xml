<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Marketplace rejects plugin IDs containing the word "intellij" (TemplateWordInPluginId). -->
    <id>dev.slidev.plugin</id>
    <name>Slidev</name>
    <vendor url="https://wordman.dev">Jan-Niklas Wortmann</vendor>

    <description><![CDATA[
        Integrated support for <a href="https://sli.dev">Slidev</a> presentations.<br>
        <ul>
            <li>Auto-detects <code>slides.md</code> Slidev projects in your workspace</li>
            <li>Starts, adopts, and stops the Slidev dev server (configurable dev command and port)</li>
            <li>Live side-by-side preview with bidirectional editor &harr; preview navigation sync,
                click stepping, and an overview mode</li>
            <li>Slides tree with drag-and-drop reordering and a projects tree for multi-entry workspaces</li>
            <li>Per-slide code folding, slide-number annotations, and frontmatter highlighting in the editor</li>
            <li>Schema-driven completion, quick documentation, and validation for slide frontmatter
                (headmatter and per-slide)</li>
        </ul>
        Port of the official Slidev VS Code extension.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- WebProjectTemplate and the moduleBuilder EP (New Project wizard) live in the lang module,
         which every IntelliJ-based IDE ships. -->
    <depends>com.intellij.modules.lang</depends>
    <!-- The "Markdown" language is defined by this plugin; folding registration is optional so the
         rest of the plugin works in IDEs where Markdown support is disabled or absent. -->
    <depends optional="true" config-file="slidev-markdown.xml">org.intellij.plugins.markdown</depends>
    <!-- The headmatter is a YAML injection host (Markdown front-matter support), so docs and
         completion there must also be registered against the YAML language. -->
    <depends optional="true" config-file="slidev-yaml.xml">org.jetbrains.plugins.yaml</depends>
    <!-- MCP tools (port of lmTools.ts); only active where the bundled MCP server plugin is available. -->
    <depends optional="true" config-file="slidev-mcp.xml">com.intellij.mcpServer</depends>
    <!-- JS/TS languages come from the JavaScript plugin (paid IDEs / IDEA non-free mode);
         script-block and Vue-expression support is optional so the plugin keeps working
         without it. -->
    <depends optional="true" config-file="slidev-javascript.xml">JavaScript</depends>

    <resource-bundle>messages.SlidevBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Slidev" anchor="right" canCloseContents="false"
                    factoryClass="dev.slidev.intellij.ui.SlidevToolWindowFactory"
                    icon="dev.slidev.intellij.SlidevIcons.ToolWindow"/>
        <postStartupActivity implementation="dev.slidev.intellij.startup.SlidevStartupActivity"/>
        <projectConfigurable parentId="tools" id="dev.slidev.intellij.settings"
                             key="configurable.slidev.display.name"
                             nonDefaultProject="true"
                             instance="dev.slidev.intellij.settings.SlidevSettingsConfigurable"/>
        <notificationGroup id="Slidev" displayType="BALLOON" key="notification.group.slidev"/>
        <editor.linePainter implementation="dev.slidev.intellij.editor.SlidevSlideLinePainter"/>
        <!-- Hover/caret quick docs for frontmatter keys. Offset-based and language-independent,
             so it covers both the injected-YAML headmatter and plain-Markdown slide blocks; must
             be this V2 EP because hover resolves YAML key declarations before ever reaching the
             legacy lang.documentationProvider registrations. -->
        <platform.backend.documentation.targetProvider
                implementation="dev.slidev.intellij.editor.SlidevFrontmatterDocumentationTargetProvider"/>
        <fileEditorProvider implementation="dev.slidev.intellij.ui.preview.SlidevSplitEditorProvider"/>
        <fileIconProvider implementation="dev.slidev.intellij.ui.SlidevFileIconProvider"/>
        <!-- New Project wizard, twice for the two wizard flavors: directoryProjectGenerator is read
             by WebStorm-style dialogs, moduleBuilder by IntelliJ IDEA's unified wizard. -->
        <directoryProjectGenerator implementation="dev.slidev.intellij.generator.SlidevProjectGenerator"/>
        <moduleBuilder builderClass="dev.slidev.intellij.generator.SlidevModuleBuilder"/>
    </extensions>

    <projectListeners>
        <listener class="dev.slidev.intellij.editor.SlidevAnnotationsRefresher"
                  topic="dev.slidev.intellij.project.SlidevListener"/>
        <listener class="dev.slidev.intellij.ui.SlidevFileIconRefresher"
                  topic="dev.slidev.intellij.project.SlidevListener"/>
    </projectListeners>

    <actions>
        <action id="Slidev.PrevSlide" class="dev.slidev.intellij.actions.SlidevPrevSlideAction"
                icon="AllIcons.Actions.PreviousOccurence">
            <keyboard-shortcut keymap="$default" first-keystroke="alt UP"/>
        </action>
        <action id="Slidev.NextSlide" class="dev.slidev.intellij.actions.SlidevNextSlideAction"
                icon="AllIcons.Actions.NextOccurence">
            <keyboard-shortcut keymap="$default" first-keystroke="alt DOWN"/>
        </action>

        <group id="Slidev.PreviewToolbar">
            <action id="Slidev.PreviewPrevSlide" class="dev.slidev.intellij.actions.SlidevPreviewPrevSlideAction"
                    icon="AllIcons.Actions.PreviousOccurence"/>
            <action id="Slidev.PreviewNextSlide" class="dev.slidev.intellij.actions.SlidevPreviewNextSlideAction"
                    icon="AllIcons.Actions.NextOccurence"/>
            <action id="Slidev.PrevClick" class="dev.slidev.intellij.actions.SlidevPrevClickAction"
                    icon="AllIcons.Actions.Back"/>
            <action id="Slidev.NextClick" class="dev.slidev.intellij.actions.SlidevNextClickAction"
                    icon="AllIcons.Actions.Forward"/>
            <separator/>
            <action id="Slidev.StartServer" class="dev.slidev.intellij.actions.SlidevStartServerAction"
                    icon="AllIcons.Actions.Execute"/>
            <action id="Slidev.StopServer" class="dev.slidev.intellij.actions.SlidevStopServerAction"
                    icon="AllIcons.Actions.Suspend"/>
            <action id="Slidev.OpenInBrowser" class="dev.slidev.intellij.actions.SlidevOpenInBrowserAction"
                    icon="AllIcons.Nodes.PpWeb"/>
            <action id="Slidev.RefreshPreview" class="dev.slidev.intellij.actions.SlidevRefreshPreviewAction"
                    icon="AllIcons.Actions.Refresh"/>
            <separator/>
            <action id="Slidev.ToggleSync" class="dev.slidev.intellij.actions.SlidevToggleSyncAction"
                    icon="AllIcons.Actions.Lightning"/>
            <action id="Slidev.TogglePreviewMode" class="dev.slidev.intellij.actions.SlidevTogglePreviewModeAction"
                    icon="AllIcons.Actions.GroupBy"/>
        </group>

        <action id="Slidev.ChooseEntry" class="dev.slidev.intellij.actions.SlidevChooseEntryAction"
                icon="AllIcons.Actions.ListFiles"/>

        <group id="Slidev.ProjectsToolbar">
            <action id="Slidev.AddEntry" class="dev.slidev.intellij.actions.SlidevAddEntryAction"
                    icon="AllIcons.General.Add"/>
            <action id="Slidev.Rescan" class="dev.slidev.intellij.actions.SlidevRescanAction"
                    icon="AllIcons.Actions.Refresh"/>
        </group>

        <group id="Slidev.ProjectsContext">
            <action id="Slidev.SetActive" class="dev.slidev.intellij.actions.SlidevSetActiveAction"
                    icon="AllIcons.Actions.Show"/>
            <action id="Slidev.RemoveEntry" class="dev.slidev.intellij.actions.SlidevRemoveEntryAction"
                    icon="AllIcons.General.Remove"/>
        </group>

        <group id="Slidev.EditorNavigation">
            <reference ref="Slidev.PrevSlide"/>
            <reference ref="Slidev.NextSlide"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
